# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N_AGENT_WEBHOOK_URL: Active production webhook URL for the n8n AI voice/chat agent.
# The webhook should accept JSON body fields: prompt and sessionId.
N8N_AGENT_WEBHOOK_URL="https://your-n8n-domain/webhook/171bf9a6-1390-4195-bd6b-ff3df2e27d1c"

# ── Writer onboarding: verification delivery ─────────────────────────────────
# Email (choose one). Without a provider, codes are printed to the server console
# in development and sending is refused in production (NODE_ENV=production).
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="AssignmentMinds <no-reply@yourdomain.com>"
# SMS via Twilio (international). Use either a From number or a Messaging Service.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Secret used to hash one-time codes (defaults to JWT_SECRET).
OTP_SECRET=""
# Private storage for writer documents/photos (never served statically).
WRITER_STORAGE_DIR=""

# ── Writer memberships: Razorpay (optional online payments) ─────────────────
# When set, writers can pay online; payments are verified server-side (signature +
# API re-check of amount/currency). International currencies must be enabled on
# your Razorpay account. Webhook URL: <API>/api/membership/webhooks/razorpay
# (events: payment.captured, order.paid, payment.failed).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Manual payments (UPI / PayPal / bank reference + admin verification) are
# configured in Admin → Memberships → Settings.

# ── Security (required in production) ───────────────────────────────────────
# Long random values (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
# Without them production uses a random per-process secret, so everyone is signed
# out whenever the server restarts.
JWT_SECRET=""
ADMIN_SECRET=""
# Keys anti-abuse fingerprints (hashed sign-up IPs). Defaults to JWT_SECRET.
FINGERPRINT_SECRET=""
# Extra browser origins allowed to call the API with credentials, comma-separated
# (APP_URL is always allowed). Add any custom domain here, e.g. https://assignmentminds.com
CORS_ORIGINS=""
# First super-admin password on an empty production database (min 12 chars).
# If unset, a one-time password is generated and printed once to the server log.
ADMIN_INITIAL_PASSWORD=""
# Used only by `node reset-admin-secure.js`.
ADMIN_RESET_PASSWORD=""
# Extra throwaway-email domains to refuse at writer sign-up, comma-separated.
DISPOSABLE_EMAIL_DOMAINS=""

# ── Server-side AI keys ─────────────────────────────────────────────────────
# Never prefix server secrets with VITE_: every VITE_* variable can be compiled
# into the public JavaScript bundle. (The build now fails if one would leak.)
INCEPTION_API_KEY=""

# ── Notifications: WhatsApp (optional) ───────────────────────────────────────
# Uses the Twilio credentials above. Business-initiated WhatsApp messages need a
# Meta-approved template: set its Content SID (template variable {{1}} = message).
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_CONTENT_SID=""

# ── Catalogue, CMS & public pages ─────────────────────────────────────────
# Subjects, services, projects, pricing, content blocks and SEO all live in
# MongoDB (MONGO_URI) and are edited in Admin → Catalog & Pricing; the website
# reads them at runtime, so no redeploy is needed after an admin change.
# APP_URL (above) is the public site origin used for canonical URLs, og:url and
# /sitemap.xml. Catalogue images/files are stored privately here (default:
# server/private_uploads/catalog). On Render, point it at a persistent disk.
CATALOG_STORAGE_DIR=""
# Frontend (Vite build): the API base, e.g. https://your-api.onrender.com/api
# VITE_API_URL=""
